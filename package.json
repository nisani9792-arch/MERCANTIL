    "@tanstack/react-query": "^5.80.7",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "jose": "^6.0.11",
    "lucide-react": "^1.18.0",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.7",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.65.0"
  },
  "type": "module",
  "overrides": {
    "brace-expansion@<1.1.21": "1.1.21",
    "browserslist@<4.28.7": "4.28.7",
    "baseline-browser-mapping@<2.11.0": "2.11.0",
    "source-map-js@<1.2.2": "1.2.2",
    "brace-expansion@>=2 <2.1.7": "2.1.7",
    "uuid": "11.1.1",
    "js-yaml@>=4 <4.3.2": "4.3.2",
    "postcss@<=8.5.22": "8.5.23",
    "glob@>=9 <14.0.2": "14.0.2",
